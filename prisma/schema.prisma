// =============================================================================
// GetSpecial — Schéma Prisma
//
// Modèle de données du MVP. Suit la boucle produit :
// User → Restaurant (KNOW) → Signal (OBSERVE) → Opportunity (THINK)
// → Content (CREATE) → Publication (PUBLISH) → FeedbackEvent (LEARN)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Utilisateur ---

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  restaurants  Restaurant[]
}

// --- KNOW : Context Store ---

model Restaurant {
  id           String        @id @default(cuid())
  name         String
  type         String        // fast-food, restaurant, bar, café, boulangerie, food-truck
  address      String
  latitude     Float
  longitude    Float
  timezone     String        @default("Europe/Paris")
  openingHours Json?         // { "mon": "09:00-22:00", ... }
  specialties  String[]      // tags de spécialités
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  signals       Signal[]
  contents      Content[]
  publications  Publication[]
  feedbackEvents FeedbackEvent[]
}

// --- OBSERVE : Signal Collector ---

model Signal {
  id           String        @id @default(cuid())
  type         String        // weather, event, holiday, custom
  source       String        // open-meteo, openholidays, manual
  data         Json          // données brutes du signal
  detectedAt   DateTime      @default(now())

  restaurantId String
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  opportunities Opportunity[]
}

// --- THINK : Opportunity Engine ---

model Opportunity {
  id             String    @id @default(cuid())
  title          String
  description    String
  relevanceScore Float     // 0.0 à 1.0
  suggestedAt    DateTime  @default(now())
  status         String    @default("pending") // pending, accepted, dismissed

  signalId       String
  signal         Signal    @relation(fields: [signalId], references: [id], onDelete: Cascade)

  contents       Content[]
}

// --- CREATE : Content Generator ---

model Content {
  id           String        @id @default(cuid())
  text         String
  imageUrl     String?
  platform     String        // instagram, facebook, google-business
  status       String        @default("draft") // draft, ready, published
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  restaurantId String
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  opportunityId String?
  opportunity   Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  publications  Publication[]
}

// --- PUBLISH : Publisher ---

model Publication {
  id            String    @id @default(cuid())
  platform      String    // instagram, facebook, google-business
  externalPostId String?  // ID du post sur la plateforme
  publishedAt   DateTime?
  scheduledAt   DateTime?
  status        String    @default("scheduled") // scheduled, published, failed

  contentId     String
  content       Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)

  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  feedbackEvents FeedbackEvent[]
}

// --- LEARN : Feedback Loop ---

model FeedbackEvent {
  id            String    @id @default(cuid())
  type          String    // sale, engagement, reach, click
  value         Float     // montant vente, nombre likes, etc.
  recordedAt    DateTime  @default(now())

  publicationId String?
  publication   Publication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)

  restaurantId  String
  restaurant    Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}
