generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String?
  avatarUrl   String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  auditLogs   AuditLog[]
  restaurants Restaurant[]

  @@map("users")
}

model Restaurant {
  id             String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  name           String
  type           String
  address        String
  city           String?
  postalCode     String?
  country        String             @default("FR")
  phone          String?
  website        String?
  googlePlaceId  String?
  latitude       Float
  longitude      Float
  timezone       String             @default("Europe/Paris")
  openingHours   Json?
  specialties    String[]           @default([])
  status         String             @default("active")
  isPaused       Boolean            @default(false)
  userId         String
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  auditLogs      AuditLog[]
  feedbackEvents FeedbackEvent[]
  offers         Offer[]
  opportunities  Opportunity[]
  posts          Post[]
  publications   Publication[]
  profile        RestaurantProfile?
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  signals        Signal[]
  socialAccounts SocialAccount[]

  @@map("restaurants")
}

model RestaurantProfile {
  id             String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  restaurantId   String     @unique
  tone           String     @default("chaleureux")
  hasTerrace     Boolean    @default(false)
  hasDelivery    Boolean    @default(false)
  capacityCovers Int?
  averageTicket  Float?
  currency       String     @default("EUR")
  baselineCovers Int?       @default(15)
  foodCostPct    Float?
  drinkCostPct   Float?
  maxDiscountPct Float?
  offPeakDays    String[]   @default([])
  constraints    String[]   @default([])
  targetAudience String[]   @default([])
  marketingGoal  String?
  logoUrl        String?
  photos         String[]   @default([])
  brandColors    String[]   @default([])
  menuUrl        String?
  maxPostsPerDay Int        @default(1)
  autoApprove    Boolean    @default(false)
  customRules    Json?
  status         String     @default("active")
  createdAt      DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("restaurant_profile")
}

model Offer {
  id             String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  restaurantId   String
  title          String
  description    String
  discountValue  String?
  recurrence     String     @default("none")
  recurrenceDays String[]   @default([])
  lastPromotedAt DateTime?  @db.Timestamptz(6)
  status         String     @default("active")
  createdAt      DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("offers")
}

model SocialAccount {
  id                String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  restaurantId      String
  platform          String
  outstandAccountId String
  username          String?
  status            String     @default("connected")
  lastSyncAt        DateTime?  @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([restaurantId, platform], map: "uq_restaurant_platform")
  @@map("social_accounts")
}

model Signal {
  id             String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  restaurantId   String
  externalId     String?
  type           String
  category       String?
  intensity      Float         @default(1.0)
  source         String
  data           Json
  startsAt       DateTime?     @db.Timestamptz(6)
  endsAt         DateTime?     @db.Timestamptz(6)
  distanceMeters Int?
  isFallback     Boolean       @default(false)
  detectedAt     DateTime      @default(now()) @db.Timestamptz(6)
  status         String        @default("active")
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  opportunities  Opportunity[]
  restaurant     Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([restaurantId, source, externalId], map: "uq_signals_restaurant_source_external")
  @@index([restaurantId, detectedAt(sort: Desc)], map: "idx_signals_restaurant")
  @@index([restaurantId, startsAt], map: "idx_signals_restaurant_starts_at")
  @@map("signals")
}

model Opportunity {
  id              String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  restaurantId    String
  signalId        String?
  title           String
  description     String
  urgency         String          @default("medium")
  recommendedTone String?
  relevanceScore  Float           @default(0.5)
  factsCited      Json?
  status          String          @default("pending")
  forDate         String?
  timeSlot        String?
  source          String          @default("ai")
  suggestedAt     DateTime        @default(now()) @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  feedbackEvents  FeedbackEvent[]
  restaurant      Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  signal          Signal?         @relation(fields: [signalId], references: [id], onUpdate: NoAction)
  posts           Post[]

  @@index([restaurantId, status], map: "idx_opportunities_restaurant")
  @@index([restaurantId, forDate], map: "idx_opportunities_date")
  @@map("opportunities")
}

model Post {
  id            String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  restaurantId  String
  opportunityId String?
  text          String
  imageUrl      String?
  platform      String
  status        String        @default("pending_approval")
  origin            String        @default("generated")
  campaignType      String?
  aspectRatio       String        @default("4:5")
  headline          String?
  instagramCaption  String?
  facebookCaption   String?
  hashtags          String[]      @default([])
  mediaUrls         String[]      @default([])
  mediaType         String        @default("image")
  referenceImages   String[]      @default([])
  generationPayload Json?
  verifiedFacts     Json?
  scheduledAt   DateTime?     @db.Timestamptz(6)
  approvedAt    DateTime?     @db.Timestamptz(6)
  publishedAt   DateTime?     @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  opportunity   Opportunity?  @relation(fields: [opportunityId], references: [id], onUpdate: NoAction)
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  publications  Publication[]

  @@index([restaurantId, status], map: "idx_posts_restaurant_status")
  @@map("posts")
}

model Publication {
  id                 String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  restaurantId       String
  postId             String
  platform           String
  outstandPostId     String?
  sendIdempotencyKey String          @unique
  attempts           Int             @default(0)
  lastError          String?
  status             String          @default("pending")
  publishedAt        DateTime?       @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  feedbackEvents     FeedbackEvent[]
  post               Post            @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  restaurant         Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([restaurantId, status], map: "idx_publications_scheduled")
  @@map("publications")
}

model FeedbackEvent {
  id            String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  restaurantId  String
  type          String
  reason        String?
  value         Float?
  opportunityId String?
  publicationId String?
  status        String       @default("active")
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onUpdate: NoAction)
  publication   Publication? @relation(fields: [publicationId], references: [id], onUpdate: NoAction)
  restaurant    Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("feedback")
}

model AuditLog {
  id           String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  restaurantId String?
  userId       String?
  action       String
  entityType   String
  entityId     String?
  details      Json?
  ipAddress    String?
  status       String      @default("logged")
  createdAt    DateTime    @default(now()) @db.Timestamptz(6)
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onUpdate: NoAction)
  user         User?       @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([restaurantId, createdAt(sort: Desc)], map: "idx_audit_log_restaurant")
  @@map("audit_log")
}
